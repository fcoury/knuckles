# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Kibot
kibot_errors.filter
*-drc.txt
*-drc.html

# Freerouting
freerouting/freerouting-*.jar
freerouting/freerouting.log

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.kicad_pro
!kicad/projects/*.kicad_pro
*.sch-bak
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
*.pro
logs

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses
pcbs/*_autorouted.kicad_pcb
pcbs/autoroute/
pcbs/.history/
pcbs/*_preview.kicad_pcb
pcbs/*_preview-drc.rpt

# Exported BOM files
*.xml
!log4j2.xml
*.csv

# MacOS
.DS_Store

# ergogen
build/
pcbs/build-info.json
outlines/_*.*
outlines/*.yaml
pcbs/_*.*
points
source
cases/*.stl
ergogen/output/gerbers/
ergogen/output/images/

# npm
node_modules

# gerbers
gerbers/*/*
!gerbers/*/*.zip
