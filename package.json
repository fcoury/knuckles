{
  "scripts": {
    "test": "node --test scripts/build.test.mjs",
    "build": "node scripts/build.mjs",
    "debug": "node scripts/build.mjs --debug",
    "route": "./scripts/autoroute.sh knuckles_wireless",
    "sync:kicad-projects": "node scripts/sync-kicad-projects.mjs",
    "watch:build": "nodemon -e yaml,js,mjs -x \"npm run build\"",
    "watch:debug": "nodemon -e yaml,js,mjs -x \"npm run debug\"",
    "build:integrated": "node scripts/build-integrated.mjs",
    "check:integrated": "python3 -B hardware/integrated-controller/validate.py"
  },
  "dependencies": {
    "js-yaml": "^3.14.1",
    "ergogen": "^4.1.0",
    "nodemon": "^3.0.1",
    "@jscad/cli": "1.10.0"
  },
  "nodemonConfig": {
    "delay": 2500
  }
}
